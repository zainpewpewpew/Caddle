# Salin ke .env lalu sesuaikan. Jangan commit file .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./data/alphalens.db
# Origin publik aplikasi (skema+host+port). Di produksi wajib https.
APP_ORIGIN=http://127.0.0.1:8080
# auto = Secure bila APP_ORIGIN https
COOKIE_SECURE=auto
# true hanya bila berada di belakang reverse proxy tepercaya
# false, atau IP/CIDR reverse proxy tepercaya (mis. 127.0.0.1). `true` ditolak.
TRUST_PROXY=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=300
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_MINUTES=15
MAX_USERS=2
# Akun default prototipe lokal (admin / alphalens-demo). Kosong = aktif hanya bila NODE_ENV=development;
# dibuat hanya bila HOST & APP_ORIGIN loopback, TRUST_PROXY=false, dan belum ada pengguna.
# false = nonaktif. true ditolak di produksi.
DEFAULT_USER=
LOG_LEVEL=info
# Tombol "Jalankan scanner" / "Hentikan scanner" di System Health (khusus admin): server menjalankan
# worker sebagai proses terpisah, jadi cukup `npm start`. Kosong = aktif hanya bila NODE_ENV=development
# (nonaktif di test & produksi). true/false untuk menimpa.
WORKER_CONTROL=
# true = server langsung menjalankan worker saat start (butuh WORKER_CONTROL aktif). Default false.
# Jangan dipakai bersamaan dengan `npm run worker` di terminal lain.
WORKER_AUTOSTART=false
# --- Insider / Smart Money Radar (fitur baca saja: hanya alamat publik, tidak pernah meminta private key) ---
# Kunci jalur gratis (lihat docs/17 "Mengaktifkan data live"). Isi di .env Mac, JANGAN ditempel di chat.
# Etherscan API V2 gratis (riwayat transfer wallet EVM): https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# OPSIONAL. Binance API key HANYA izin "Enable Reading" (daftar kontrak aset → pasar). Kunci dengan izin
# trading/penarikan ditolak. Kosong = cukup ETHERSCAN_API_KEY: daftar kontrak diambil dari endpoint publik Binance
# tanpa kunci (provider binance-public). Bila diisi, kunci ini didahulukan (binance-mapping).
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Opsional: kunci Routescan gratis (tanpa kunci pun jalan, lebih lambat).
# ROUTESCAN_API_KEY=
# Provider aktif. Kosong/auto (default) = otomatis mengikuti kunci yang terisi: ETHERSCAN_API_KEY → etherscan,
# routescan, geckoterminal + binance-public; kunci Binance → binance-mapping (menggantikan binance-public).
# Tanpa kunci = fitur belum dikonfigurasi (tidak ada
# data simulasi). `off` = matikan. Atau daftar eksplisit dipisah koma (urutan = prioritas).
# `fixture` = data SIMULASI khusus tes/demo (ditolak di produksi).
# SMART_MONEY_PROVIDERS=
# Interval sinkronisasi dalam menit (5..1440, default 15).
# SMART_MONEY_SYNC_MINUTES=15
# Data dianggap basi bila sinkronisasi sukses terakhir lebih tua dari ini, dalam menit (1..10080, default 60).
# SMART_MONEY_STALE_MINUTES=60
# Jumlah maksimum wallet yang disinkronkan per siklus (1..500, default 50).
# SMART_MONEY_MAX_WALLETS=50
