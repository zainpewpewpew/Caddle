{
  "name": "alphalens",
  "version": "0.1.0",
  "private": true,
  "description": "AlphaLens — terminal intelijen kripto privat (riset & decision-support).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/app/server.js",
    "dev": "node --env-file-if-exists=.env --watch backend/app/server.js",
    "worker": "node --env-file-if-exists=.env worker/index.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.js",
    "user:password": "node --env-file-if-exists=.env scripts/change-password.js",
    "backtest": "node --env-file-if-exists=.env scripts/backtest.js",
    "smart-money:sync": "node --env-file-if-exists=.env scripts/smart-money-sync.js",
    "smart-money:evaluate": "node --env-file-if-exists=.env scripts/smart-money-evaluate.js",
    "smart-money:check": "node --env-file-if-exists=.env scripts/smart-money-check.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/positive tests/negative tests/edge tests/security",
    "test:e2e": "playwright test",
    "test:live": "LIVE_BINANCE=1 vitest run --config vitest.live.config.js",
    "audit": "npm audit --omit=dev",
    "report:tests": "vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest-results.json && playwright test && node scripts/test-report.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "lightweight-charts": "5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "vitest": "5.0.5"
  }
}
